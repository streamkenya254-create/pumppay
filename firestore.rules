rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isOwner(d) { return signedIn() && d.customerId == request.auth.uid; }

    // Admin list is managed in the console only
    match /admins/{uid}      { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }

    match /customers/{uid}   { allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
                               allow write: if isAdmin(); }

    match /devices/{id}      { allow read: if isAdmin() || isOwner(resource.data);
                               allow write: if isAdmin(); }
    match /deviceKeys/{id}   { allow read, write: if isAdmin(); }

    // Payments are written only by Cloud Functions (admin SDK)
    match /payments/{id}     { allow read: if isAdmin() || isOwner(resource.data); allow write: if false; }

    // Hourly pump usage — written only by deviceSync (admin SDK)
    match /usage/{id}        { allow read: if isAdmin() || isOwner(resource.data); allow write: if false; }

    match /plans/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /products/{id}     { allow read: if true; allow write: if isAdmin(); }

    match /orders/{id} {
      allow read: if isAdmin() || isOwner(resource.data);
      allow create: if isOwner(request.resource.data) && request.resource.data.status == "pending"
                    && request.resource.data.price is number;
      allow update, delete: if isAdmin();
    }

    match /tickets/{id} {
      allow read: if isAdmin() || isOwner(resource.data);
      allow create: if isOwner(request.resource.data) && request.resource.data.status == "open"
                    && request.resource.data.message is string && request.resource.data.message.size() < 2000;
      allow update, delete: if isAdmin();
    }

    // Website enquiry form — anyone can create, only admins read
    match /leads/{id} {
      allow create: if request.resource.data.keys().hasOnly(["name","phone","county","acres","waterSource","plan","status","source","createdAt"])
                    && request.resource.data.name is string && request.resource.data.name.size() < 100
                    && request.resource.data.phone is string && request.resource.data.phone.size() < 20
                    && request.resource.data.status == "new";
      allow read, update, delete: if isAdmin();
    }
  }
}
