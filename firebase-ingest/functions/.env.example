# Where the money lands. Fill these in, copy this file to ".env" in this folder, then deploy.
# They are not secret, but a wrong value sends customers' money to the wrong Till,
# so there is no default.

# Your Daraja BusinessShortCode (the Organization shortcode used to build the STK password)
MPESA_SHORTCODE=

# The Till number customers pay to (PartyB)
MPESA_TILL=

# "production" for real money, "sandbox" for Safaricom's test environment
MPESA_ENV=sandbox
